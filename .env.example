#app
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174
#only used on the server (caddy hostname), deploy/setup.sh fills it in
APP_HOST=
JWT_SECRET=change-me-to-a-long-random-string
SEED_USER_PASSWORD=resolvr123

#postgres
POSTGRES_USER=resolvr
POSTGRES_PASSWORD=resolvr
POSTGRES_DB=resolvr

#llm
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_FAST_MODEL_NAME=gemini-3.5-flash
GEMINI_FALLBACK_MODEL_NAME=gemini-3.5-flash,gemini-3.7-flash
LLM_MIN_INTERVAL_MS=13000

#retrieval
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
TORCH_THREADS=8
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
ABSTAIN_THRESHOLD=0.55

#review rules
APPROVAL_SEVERITIES=critical
REVIEW_SLA_MINUTES=30

#notifications (ntfy)
NTFY_BASE_URL=https://ntfy.sh
NTFY_ADMIN_TOPIC=
NTFY_AGENT_TOPIC=
NTFY_TOKEN=

#email
#defaults point at the local mailpit container (http://localhost:8026)
#for gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true + an app password
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Resolvr <reports@resolvr.local>
SMTP_USE_TLS=false
ADMIN_EMAILS=admin@resolvr.local

#daily digest
DIGEST_HOUR=21
DIGEST_MINUTE=0

#helpdesk webhook
WEBHOOK_SECRET=change-me

#langsmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolvr

#grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
